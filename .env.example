# LLM (Ollama, local; the only provider implemented, see agents/llm.py)
# qwen3:4b is the tested default on CPU (~10-30 min per bid). Larger models (e.g. qwen3:8b) are untested here and slower.
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings and re-ranking (local, fastembed / ONNX Runtime)
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
# Where models are downloaded (default ~/.cache/fastembed; the system temp folder gets cleared)
# MODEL_CACHE_DIR=

# Storage
INDEX_DIR=./index

# Bid folders indexed when the API starts
DATA_DIR=./data
# UI -> API address
API_URL=http://127.0.0.1:8000
